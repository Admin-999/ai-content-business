# ============ Backend: база данных ============
# Supabase -> Project Settings -> Database -> Connection string -> URI (порт 6543, пулер).
# Замените [YOUR-PASSWORD] на пароль базы. Пример:
# DATABASE_URL=postgresql://postgres.abcdefgh:password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# Если не задан — локально используется SQLite (файл backend/local.db), работает сразу.
DATABASE_URL=

# ============ Backend: безопасность ============
# Сгенерируйте: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-change-me
# Секрет для cron-эндпоинта (тот же value добавьте в секреты GitHub Actions)
CRON_SECRET=change-me-cron-secret

# ============ AI-провайдеры (все бесплатные) ============
# Google Gemini: https://aistudio.google.com/apikey -> Create API key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Groq (резерв, необязательно): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ============ CORS ============
# Адреса frontend через запятую. Для локальной разработки:
FRONTEND_ORIGIN=http://localhost:5500,http://127.0.0.1:5500
# В продакшене добавьте адрес Vercel: https://<ваш-проект>.vercel.app
FRONTEND_URL=

# ============ Email (Resend free: 100 писем/день) ============
# https://resend.com -> API Keys
RESEND_API_KEY=
EMAIL_FROM=AI Контент <onboarding@resend.dev>
EMAIL_REPORT_MAX=80

# ============ Тарифы ============
FREE_DAILY_LIMIT=5
PRO_DAILY_LIMIT=100
PRO_PRICE_RUB=990
PRO_PERIOD_DAYS=30
TOKEN_TTL_DAYS=7
